{
  "name": "office-seat-manager-web",
  "private": true,
  "version": "0.1.0",
  "description": "オフィス座席・従業員管理システムの画面（Vue 3 + Vite + TypeScript）",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:html": "node scripts/check-html.mjs",
    "test:e2e": "npm run build && playwright test",
    "nginx:start": "node scripts/nginx.mjs start",
    "nginx:stop": "node scripts/nginx.mjs stop",
    "nginx:reload": "node scripts/nginx.mjs reload"
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
